<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E2B30">

    <!-- ===== TOP BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#243138"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <!-- Cross / Plus icon accent bar -->
        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#00CECE"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/Adminn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenue, Admin"
                android:textColor="#EFEFEF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cabinet Médical"
                android:textColor="#00CECE"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.08"/>
        </LinearLayout>

        <!-- Avatar badge -->
        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_teal"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AD"
                android:textColor="#1E2B30"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== STATS ROW ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <!-- Consultations card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Teal top accent line -->
            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:background="#00CECE"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSULTATIONS"
                android:textColor="#7A9BAB"
                android:textSize="9sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/tvStatConsultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#EFEFEF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="total"
                android:textColor="#00A8A8"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Revenus card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:background="#00A8A8"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVENUS"
                android:textColor="#7A9BAB"
                android:textSize="9sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/tvStatRevenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#EFEFEF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAD total"
                android:textColor="#00A8A8"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== BUTTON AJOUT PATIENT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnAddPatient"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="＋  Ajouter un patient"
            android:textAllCaps="false"
            android:textColor="#1E2B30"
            android:backgroundTint="#00CECE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.03"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- ===== SCROLLABLE CONTENT ===== -->

    <!-- ===== BOTTOM NAV BAR ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="398dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── PATIENTS SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="18dp"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:background="#00CECE" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="LISTE DES PATIENTS"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#DADADA" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/patientContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ── CONSULTATIONS SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="22dp"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:background="#00A8A8" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="LISTE DES CONSULTATIONS"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#DADADA" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/consultationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>




</LinearLayout>