<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dossier Patient"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_dark"
            android:layout_marginBottom="30dp">

            <TextView
                android:id="@+id/tvPatientDetailNom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Chargement du nom..."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPatientDetailEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉️ email@patient.com"
                android:textColor="#A0AEC0"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvPatientDetailId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Patient : --"
                android:textColor="#00CECE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historique des Consultations"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />
        <Button
            android:id="@+id/btnNouvelleConsultation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Nouvelle Consultation"
            android:textColor="#0F172A"
            android:backgroundTint="#00CECE"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="14dp"
            android:layout_marginBottom="25dp" />
        <LinearLayout
            android:id="@+id/consultationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>